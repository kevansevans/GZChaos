class GZC_CoreThinker : Thinker
{
	Array<Class<GZC_Effect> > history;
	Array<GZC_Effect> active;

	static GZC_CoreThinker create()
	{
		let ct = new('GZC_CoreThinker');
		ct.active.clear();
		ct.history.clear();
		return ct;
	}

	clearscope static GZC_CoreThinker get()
	{
		ThinkerIterator it = ThinkerIterator.create('GZC_CoreThinker', STAT_Static);
		GZC_CoreThinker ct;
		
		while (ct = GZC_CoreThinker(it.next()))
		{
			if (ct) break;
			else throwAbortException("Core Thinker has not been created! If you're seeing this, tell kev!");
		}
		
		return ct;
	}
	
	clearscope static int getActiveEffectCount()
	{
		let ct = GZC_CoreThinker.get();
		return ct.active.size();
	}

	override void PostBeginPlay()
	{
		ChangeStatNum(STAT_STATIC);
	}
	
	override void Tick()
	{
		//No super! Empty method on purpose just in case STAT_Static doesn't eliminate a Thinker's tick function
	}
	
	////////////////////////////////////////////////////////////////////////////////////////////////////
	//Effect functions
	////////////////////////////////////////////////////////////////////////////////////////////////////
	
	void worldThingDied(WorldEvent _event)
	{
		foreach (effect : active)
		{
			if (!effect) continue;
			if (effect.life > effect.duration) continue;
			effect.onWorldThingDied(_event);
		}
	}
	
	void worldThingSpawned(WorldEvent _event)
	{
		foreach(effect : active)
		{
			if (!effect) continue;
			if (effect.life > effect.duration) continue;
			effect.onWorldThingSpawn(_event);
		}
	}
	
	void worldThingDamaged(WorldEvent _event)
	{
		foreach(effect : active)
		{
			if (!effect) continue;
			if (effect.life > effect.duration) continue;
			effect.onWorldThingDamaged(_event);
		}
	}
	
	void worldLinePreActivated(WorldEvent _event)
	{
		foreach(effect : active)
		{
			if (!effect) continue;
			if (effect.life > effect.duration) continue;
			effect.onWorldLinePreActivated(_event);
		}
	}
	
	bool WorldHitscanPreFired(WorldEvent _event)
	{
		bool result;
		
		foreach(effect : active)
		{
			if (!effect) continue;
			if (effect.life > effect.duration) continue;
			bool value = effect.onWorldHitscanPreFired(_event);
			if (value) result = value;
		}
		
		return result;
	}
	
	ui bool InputProcess(InputEvent _event)
	{
		bool result = false;
		
		foreach(effect : active)
		{
			if (effect.life > effect.duration) continue;
			bool value = effect.onInputProcess(_event);
			if (value) result = true;
		}
		
		let bind = Bindings.GetBinding(_event.keyscan);
		
		return result;
	}
	
	ui void RenderOverlay(RenderEvent _event)
	{
		foreach(effect : active)
		{
			if (!effect) continue;
			if (effect.life > effect.duration) continue;
			effect.drawEffect(_event);
		}
	}
}