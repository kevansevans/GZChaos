enum GZC_EffectType
{
	GZC_Timed,
	GZC_Instant,
	GZC_HiddenTimer,
}

enum GZC_NetMode
{
	GZC_Neutral,
	GZC_MultiplayerOnly,
	GZC_SingleplayerOnly
}

enum GZC_GameComp
{
	GZC_Any,
	GZC_Doom,
	GZC_Heretic,
	GZC_Strife,
	GZC_Hexen,
	GZC_Chex
}

Class GZC_Effect : Object play
{
	bool ignore;
	int duration;
	string title;
	string desc;
	double value;
	GZC_EffectType type;
	GZC_NetMode NetMode;
	bool seedfriendly;
	bool pure;
	double life;
	bool closed;
	bool deleteme;
	bool awarded;
	GZC_GameComp gamecomp;
	
	virtual void init()
	{
		ignore = false;
		seedfriendly = true;
		type = GZC_Timed;
		duration = 35 * 30;
		title = "GZC_UnamedEffect";
		desc = "No Description provided";
		gamecomp = GZC_Any;
		NetMode = GZC_Neutral;
		
		if (!multiplayer)
		{
			let debug = Cvar.getCvar('GZC_LastRolledEffect');
			debug.setString(self.getClassName());
			Cvar.SaveConfig();
		}
	}
	
	static int seed()
	{
		let cvarseed = Cvar.getCvar('GZC_ActiveSeed');
		return cvarseed.getInt();
	}
	
	play void adjustTimer(Double _amount)
	{
		let event = GZC_EventHandler(StaticEventHandler.find('GZC_EventHandler'));
		event.time += _amount;
		
		if (event.time < 0) event.time = 0;
	}
	
	void advanceEffect(Double _amount)
	{
		life += _amount;
		if (life >= duration + (35 * 15))
		{
			deleteme = true;
		}
	}
	
	bool mapHasThisActor(String _classname)
	{
		ThinkerIterator it = ThinkerIterator.create(_classname);
		Actor mo;
		
		//this loop will literally not execute if the map lacks the provided class name
		while (mo = Actor(it.next()))
		{
			return true;
		}
		
		return false;
	}
	
	Static Actor getRandomPlayer()
	{
		Array<PlayerInfo> list;
		list.clear();
		
		foreach (player : players)
		{
			if (!player.mo) continue;
			list.push(player);
		}
		
		if (list.size() == 1) return list[0].mo;

		int rng = random(0, list.size() - 1);
		return list[rng].mo;
	}
	
	Static PlayerInfo getRandomPlayerInfo()
	{
		Array<PlayerInfo> list;
		list.clear();
		
		foreach (player : players)
		{
			if (!player.mo) continue;
			list.push(player);
		}
		
		if (list.size() == 1) return list[0];

		int rng = random(0, list.size() - 1);
		return list[rng];
	}
	
	virtual bool verify()
	{
		let properties = GZC_EventHandler(StaticEventHandler.find('GZC_EventHandler')).EffectProperties;
		if (properties.at(self.getClassName()) == "false") return false;
		
		switch (NetMode)
		{
			case GZC_Neutral:
				break;
			case GZC_MultiplayerOnly:
				if (!multiplayer) return false;
				break;
			case GZC_SingleplayerOnly:
				if (multiplayer) return false;
				break;
		}
		
		/*if (gamecomp != GZC_Any)
		{
			switch (GameInfo.GameType)
			{
				case GAME_Doom:
					if (gamecomp != GZC_Doom) return false;
				case GAME_
			}
		}*/
		
		return true;
	}
	
	virtual play void onOpen()
	{}
	
	virtual play void onClose()
	{}
	
	virtual clearscope void onUiClose()
	{}
	
	virtual play void onWorldLoad(WorldEvent _event)
	{}
	
	virtual play void onWorldThingSpawn(WorldEvent _event)
	{}
	
	virtual play void onWorldThingDied(WorldEvent _event)
	{}
	
	virtual play void onWorldThingDamaged(WorldEvent _event)
	{}
	
	virtual play void onWorldTick()
	{}
	
	virtual play void onWorldLinePreActivated(WorldEvent _event)
	{}
	
	virtual play bool onWorldHitscanPreFired(WorldEvent _event)
	{
		return false;
	}
	
	virtual ui bool onInputProcess(InputEvent _event)
	{
		return false;
	}
	
	virtual ui void onUiTick()
	{}
	
	virtual ui void drawEffect(RenderEvent _event)
	{}
	
	virtual play void morphActor(Actor mo, Class<Actor> type)
	{
		bool ambush = mo.bAmbush;
		bool hasTarget = mo.target == null;
	
		mo.bDontMorph = false;
		mo.A_Morph(type, int(self.duration - self.life));
		mo.bAmbush = ambush;
		if (!hasTarget) mo.A_ClearTarget();
	}
}

class GZC_TestEffect : GZC_Effect
{
	override void init()
	{
		title = "Test effect";
		desc = "This is a test effect :D";
	}
}

/*
Reserve this area for base effects that need their verify function to trigger
on a wide range of effects.
*/

Class GZC_MorphEffect : GZC_Effect
{
	override void init()
	{
		ignore = true;
	}

	override bool verify()
	{
		let player = players[consoleplayer].mo;
		
		int count = 0;
		ThinkerIterator it = ThinkerIterator.create('GZC_MorphEffect');
		actor item;
		while (item = Actor(it.next())) ++count;
		if (count > 1) return false;
		
		return super.verify();
	}
}

class GZC_ShaderEffect : GZC_Effect
{
	override void init()
	{
		ignore = true;
	}

	static void DisableShaders()
	{
		PPShader.SetEnabled("lowres", false);
		PPShader.SetEnabled("gb_shader", false);
		PPShader.SetEnabled("blur", false);
		PPShader.SetEnabled("liquid", false);
		PPShader.SetEnabled("negative", false);
		PPShader.SetEnabled("shrooms", false);
	}
	
	override bool verify()
	{
		let player = players[consoleplayer].mo;
		
		int count = 0;
		ThinkerIterator it = ThinkerIterator.create('GZC_ShaderEffect');
		actor item;
		while (item = Actor(it.next())) ++count;
		if (count > 1) return false;
		
		return super.verify();
	}
}

Class GZC_EffectEffect : GZC_Effect
{
	override void init()
	{
		ignore = true;
	}
	
	override bool verify()
	{
		int count = GZC_EventHandler.getEffectCount();
		if (count <= 1) return false;
	
		return Super.verify();
	}
}

