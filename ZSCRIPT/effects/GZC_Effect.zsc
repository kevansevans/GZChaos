Class ActorTracker : Actor
{
	Actor pointer;
	Class<Actor> type;
	Vector3 Pos;
}

Class EmptyActor : MorphedMonster
{
	default
	{
		-Solid;
		-Shootable;
		-CountKill;
	}
	
	States
	{
		Spawn:
			TNT1 A 1;
			Loop;
	}
}