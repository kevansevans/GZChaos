class GZC_FastTimerToHealth : GZC_TimerEffect
{
	override void init()
	{
		ignore = false;
		title = "More health = Faster Timer";
		desc = "Roll timer speed is faster the more health player has";
		duration = 35 * 60 * 3;
	}
	
	override void onWorldTick()
	{
		double count = 0;
		double pool = 0;
		foreach (iplayer : players)
		{
			if (!iplayer.mo) continue;
			else
			{
				pool += iplayer.mo.health;
				count += 1;
			}
		}
		
		double average = pool / count;
		self.value = average / 100.0;
	}
}

class GZC_SlowTimerToHealth : GZC_TimerEffect
{
	override void init()
	{
		ignore = false;
		title = "More health = Slower Timer";
		desc = "Roll timer speed is slower the more health the player has";
		duration = 35 * 60 * 3;
	}
	
	override void onWorldTick()
	{
		double count = 0;
		double pool = 0;
		foreach (iplayer : players)
		{
			if (!iplayer.mo) continue;
			else
			{
				pool += iplayer.mo.health;
				count += 1;
			}
		}
		
		double average = pool / count;
		self.value = 100.0 / average;
	}
}

class GZC_TimerRunsOnKills : GZC_Effect
{
	override void init()
	{
		ignore = false;
		title = "1 kill = 1 second";
		desc = "The roll timer and all effects will advance by 1 second every kill. They will remain frozen otherwise.";
		duration = 35 * 90;
	}
	
	override void onWorldThingDied(WorldEvent _event)
	{
		double timerate = GZC_EventHandler(StaticEventHandler.find('GZC_EventHandler')).calculateTimeRate();
		adjustTimer(35.0 * timerate);
		
		let event = GZC_EventHandler(StaticEVentHandler.find('GZC_EventHandler'));
		foreach (effect : event.active)
		{
			if (effect.type != GZC_Timed) continue;
			
			effect.life += 35.0 * timerate;
		}
	}
}

Class GZC_ResetEffectDuration : GZC_EffectEffect 
{
	override void init()
	{
		ignore = false;
		title = "Reset all effects";
		desc = "All active effects have their timers restored";
		type = GZC_Instant;
	}
	
	override void onOpen()
	{
		let event = GZC_EventHandler(StaticEVentHandler.find('GZC_EventHandler'));
		foreach (effect : event.active)
		{
			if (effect.getClassName() == self.getClassName()) continue;
			if (effect.life > effect.duration) continue;
			effect.life = 0;
		}
		
	}
}

class GZC_ShuffleEffectLife : GZC_EffectEffect 
{
	override void init()
	{
		ignore = false;
		title = "Randomize all effect progression";
		desc = "All effects will have their duration set to a random value";
		type = GZC_Instant;
	}
	
	override void onOpen()
	{
		let event = GZC_EventHandler(StaticEVentHandler.find('GZC_EventHandler'));
		foreach (effect : event.active)
		{
			if (effect.getClassName() == self.getClassName()) continue;
			if (effect.type != GZC_Timed) continue;
			if (effect.life > effect.duration) continue;
			
			effect.life = random(0, effect.duration);
		}
	}
}

class GZC_SubtractTimeFromEffects : GZC_EffectEffect
{
	override void init()
	{
		ignore = false;
		type = GZC_Instant;
		title = "Remove # seconds from effects";
		desc = "All active effects will have their timers reduced by 5 to 30 seconds";
	}
	
	override void onOpen()
	{
		int seconds = random(5, 30);
		title = "Remove " .. seconds .. " seconds from effects";
	
		let event = GZC_EventHandler(StaticEVentHandler.find('GZC_EventHandler'));
		foreach (effect : event.active)
		{
			if (effect.getClassName() == self.getClassName()) continue;
			if (effect.type != GZC_Timed) continue;
			if (effect.life > effect.duration) continue;
			
			effect.life -= seconds * 35;
			if (effect.life < 0) effect.life = 0;
		}
	}
}

class GZC_AddTimeFromEffects : GZC_EffectEffect
{
	override void init()
	{
		ignore = false;
		type = GZC_Instant;
		title = "Add # seconds to effects";
		desc = "All active effects will have their durations extended by 5 to 30 seconds";
	}
	
	override void onOpen()
	{
		int seconds = random(5, 30);
		title = "Add " .. seconds .. " seconds to effects";
	
		let event = GZC_EventHandler(StaticEVentHandler.find('GZC_EventHandler'));
		foreach (effect : event.active)
		{
			if (effect.getClassName() == self.getClassName()) continue;
			if (effect.type != GZC_Timed) continue;
			if (effect.life > effect.duration) continue;
			
			effect.life += seconds * 35;
		}
	}
}

class GZC_KillsReduce : GZC_Effect
{
	override void init()
	{
		title = "Kills extend effect duration";
		desc = "Kills will extend effect duration depending on dying thing's default health";
		duration = 35 * 60 * 3;
	}
	
	override void onWorldThingDied(WorldEvent _event)
	{
		let def = getDefaultByType(_event.thing.getClass());
		int rate = 35 * max(1, int(def.health / 35));
		
		let event = GZC_EventHandler(StaticEVentHandler.find('GZC_EventHandler'));
		foreach (effect : event.active)
		{
			if (effect.life > effect.duration) continue;
			
			effect.life -= rate;
			if (effect.life < 0) effect.life = 0;
		}
	}
}

class GZC_KillsIncrease : GZC_Effect
{
	override void init()
	{
		title = "Kills reduce effect duration";
		desc = "Kills will reduce effect duration depending on dying thing's default health";
		duration = 35 * 60 * 3;
	}
	
	override void onWorldThingDied(WorldEvent _event)
	{
		let def = getDefaultByType(_event.thing.getClass());
		int rate = 35 * max(1, int(def.health / 35));
		
		let event = GZC_EventHandler(StaticEVentHandler.find('GZC_EventHandler'));
		foreach (effect : event.active)
		{
			if (effect.life > effect.duration) continue;
			effect.life += rate;
		}
	}
}

class GZC_KillsAccelerate : GZC_Effect
{
	override void init()
	{
		title = "Kills accelerate timer";
		desc = "Kills will accelerate roll timer depending on dying things default health";
		duration = 35 * 60 * 3;
	}
	
	override void onWorldThingDied(WorldEvent _event)
	{
		let def = getDefaultByType(_event.thing.getClass());
		adjustTimer(def.health);
	}
}

class GZC_KillsDecelerate : GZC_Effect
{
	override void init()
	{
		title = "Kills decelerate timer";
		desc = "Kills will reduce roll timer depending on dying things health";
