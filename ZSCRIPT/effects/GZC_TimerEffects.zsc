class GZC_InconsistentEffectSpeed : GZC_EffectModifier
{
	override void init()
	{
		ignore = false;
		title = "??? effect speed";
		desc = "Effect duration is randomized every second";
		duration = 35 * 30 * 3;
		value = 0.5;
	}
	
	override void onWorldTick()
	{
		if (gametic % 35 != 0) return;
		
		self.value = frandom(0.0, 2.0);
	}
}

