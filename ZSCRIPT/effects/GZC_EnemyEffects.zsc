Class GZC_YouveBeenStruck : GZC_Effect
{
	override void init()
	{
		title = "Cyberfuck";
		desc = "Spawns a cyberdemon in front of the player's face to fire a single rocket";
		duration = 35 * 30;
		type = GZC_Instant;
	}

	override void onOpen()
	{
		foreach (iplayer : players)
		{
			let player = iplayer.mo;
			if (!player) continue;
		
			FLineTraceData shot;
			player.LineTrace(player.angle, 512, 0, 0, 0, 0, 0, shot);
		
			let cybie = Actor.spawn("GZC_Cyberfuck", shot.hitlocation);
			cybie.target = player;
			cybie.A_FaceTarget();
		}
	}
}

