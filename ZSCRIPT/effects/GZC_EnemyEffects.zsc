			if (!mo.bIsMonster) continue;
			if (mo is 'GZC_Chaingunner') continue;
			if (mo.health <= 0) continue;
			
			mo.A_Morph("GZC_Chaingunner", 35 * 30);
		}
	}

	override void onOpen()
	{
