class GZC_ShotgunGuyFireLostSouls : GZC_ShotgunGuyAttackEffect
{
	override void init()
	{
		title = "Shotgunners shoot Lost Souls";
		duration = 35 * 60 * 3;
		ignore = false;
	}
	
	override bool onWorldHitscanPreFired(WorldEvent _event)
	{
		if (!(_event.thing is "ShotgunGuy")) return false;
		if (_event.attackpufftype == "GZC_BulletPuff") return false;
		
		double otherradius = GetDefaultByType("LostSoul").radius;
		double prestep = 4 + (_event.thing.radius + otherradius) * 1.5;

		Vector2 move = _event.thing.target.AngleToVector(_event.thing.angle, prestep);
		Vector3 spawnpos = _event.thing.pos + (0, 0, 8);
		Vector3 destpos = spawnpos + move;
		
		Actor soul = _event.thing.Spawn("LostSoul", destpos, ALLOW_REPLACE);
		soul.angle = _event.thing.angle + frandom(-11.25, 11.25);
		soul.A_SkullAttack();
		
		return true;
	}
}